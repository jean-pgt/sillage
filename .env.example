# Adresse et port d'écoute
HOST=0.0.0.0
PORT=3000
# Adresse publique exacte de l'application (sert aux cookies, à la vérification d'origine et au retour OIDC)
APP_ORIGIN=http://localhost:3000
# Base SQLite et clé SSH de l'application
DATA_DIR=./data
SSH_KEY_PATH=./data/id_ed25519

# Premier lancement : code d'installation pour créer le compte local. Générer avec : openssl rand -hex 24
BOOTSTRAP_TOKEN=
# Mettre à false une fois la connexion OIDC vérifiée (refuse aussi les anciennes sessions locales)
LOCAL_LOGIN_ENABLED=true

# Connexion OpenID Connect (Authentik, Keycloak, Authelia, Zitadel…), en HTTPS
OIDC_PROVIDER_NAME=SSO
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Groupe obligatoire dans le jeton signé (prioritaire), ou liste explicite de « sub » autorisés
OIDC_ADMIN_GROUP=
OIDC_ADMIN_SUBJECTS=
