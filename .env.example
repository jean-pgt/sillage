# Listen address and port
HOST=0.0.0.0
PORT=3000
# Exact public URL of the app (used for cookies, origin checks and the OIDC redirect)
APP_ORIGIN=http://localhost:3000
# SQLite database and the app's SSH key
DATA_DIR=./data
SSH_KEY_PATH=./data/id_ed25519

# First launch: setup code to create the local account. Generate with: openssl rand -hex 24
BOOTSTRAP_TOKEN=
# Set to false once OIDC sign-in works (also rejects existing local sessions)
LOCAL_LOGIN_ENABLED=true

# OpenID Connect (Authentik, Keycloak, Authelia, Zitadel…), over HTTPS
OIDC_PROVIDER_NAME=SSO
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Required group in the signed ID token (takes precedence), or an explicit list of allowed "sub" values
OIDC_ADMIN_GROUP=
OIDC_ADMIN_SUBJECTS=
